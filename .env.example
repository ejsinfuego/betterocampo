# Local development config for Better Ocampo.
# Copy to .env.local and fill in values.

VITE_GOVERNMENT_NAME="BetterOcampo.org"
VITE_GOVERNMENT_TYPE="Municipality"
VITE_REGION="Bicol Region (Region V)"
VITE_PROVINCE="Camarines Sur"

VITE_WEBSITE_URL="https://betterocampo.org"
VITE_CONTACT_EMAIL=""
VITE_CONTACT_PHONE=""

VITE_FACEBOOK_URL=""
VITE_TWITTER_URL=""
VITE_INSTAGRAM_URL=""
VITE_YOUTUBE_URL=""

VITE_SITE_DESCRIPTION="Community transparency portal for the Municipality of Ocampo, Camarines Sur."
VITE_SITE_KEYWORDS="Ocampo, Camarines Sur, Bicol, local government, transparency, BetterGov"
VITE_OG_IMAGE_URL="https://betterocampo.org/og-image.jpg"
VITE_TWITTER_HANDLE=""

VITE_GOOGLE_ANALYTICS_ID=""
VITE_FACEBOOK_PIXEL_ID=""

# Optional CARTO Voyager key (https://carto.com/basemaps/apikey/).
VITE_CARTO_API_KEY=""

# --- Reporting API (server-only; never VITE_) ---
# Create a Firebase service account JSON, then map fields here.
# Also add these in the Vercel project Environment Variables.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Paste the private key with \n for newlines, e.g. "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_STORAGE_ENABLED="false"

# Signed httpOnly admin session cookie (16+ random characters).
SESSION_SECRET=""

# Google OAuth Web Client ID (same value client + server).
# Authorized JavaScript origins: http://localhost:3000 (vercel dev) and your production origin.
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""
